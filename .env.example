# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xinqing_dev?schema=public"

# Dedicated integration-test database. The database name must contain test/testing/spec/ci.
PROACTIVE_COMMIT_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xinqing_test?schema=public"
PROACTIVE_COMMIT_TEST_ALLOW_DDL="0"
CANCEL_ACCOUNT_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xinqing_test?schema=public"
PROFILE_AVATAR_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xinqing_test?schema=public"

# Auth
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_EXPIRES_DAYS="30"
ACCOUNT_CANCELLATION_CLEANUP_SECRET="replace-with-a-separate-long-random-secret"

# WeChat mini program
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
ALLOW_WEB_MOCK_LOGIN="false"

# SMS provider: Tencent Cloud SMS
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENT_SMS_REGION="ap-guangzhou"
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
TENCENT_SMS_TEMPLATE_ID_LOGIN=""
TENCENT_SMS_TEMPLATE_ID_CANCEL=""
SMS_CODE_TTL_MINUTES="5"

# AI provider
# Set AI_PROVIDER to "deepseek", "qwen", "zhipu", "openai", or "mock".
AI_PROVIDER="deepseek"
AI_MAIN_MODEL="deepseek-v4-flash"
AI_JUDGE_MODEL="deepseek-v4-flash"
AI_REWRITE_MODEL="deepseek-v4-flash"
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# AI runtime
AI_TIMEOUT_MS="45000"
AI_MAX_REWRITE_ATTEMPTS="1"
AI_JUDGE_MODE="local"
GUEST_AI_IP_DAILY_LIMIT="20"
MEMORY_V2_RESPONSE_CONTEXT_ENABLED="false"
CLINICAL_PLAN_PROMPT_ENABLED="false"
HILL_HELPING_SHADOW="false"
HILL_HELPING_ORDINARY_HANDOFF="false"

# Uploads
UPLOAD_DIR="./public/uploads"
UPLOAD_PUBLIC_BASE_URL="http://localhost:3000/uploads"
# 必须位于 Web public/uploads 之外的私有目录，仅用于账号注销媒体暂存。
CANCEL_MEDIA_STAGING_DIR=""
MAX_NOTE_MEDIA_COUNT="9"
MAX_NOTE_IMAGE_SIZE_MB="10"

# App
APP_ENV="development"
NEXT_PUBLIC_APP_NAME="慢聊小记"
# 默认不在界面显示开发验证码；仅显式测试环境可设为 true。
NEXT_PUBLIC_SHOW_DEV_CANCEL_CODE="false"
