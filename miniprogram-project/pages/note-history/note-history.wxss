.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.history-header .title {
  min-width: 0;
}

.history-back {
  position: fixed;
  left: 42rpx;
  top: 96rpx;
  z-index: 25;
}

.add-link {
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 16rpx;
  white-space: nowrap;
  color: #71877b;
  font-size: 26rpx;
  font-weight: 700;
}

.intro {
  margin-top: 22rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 28rpx;
  height: 88rpx;
  margin-top: 42rpx;
  border-radius: 32rpx;
  background: #fffdf9;
  padding: 0 40rpx;
  color: #71877b;
}

.search-box input {
  flex: 1;
  color: #6d665f;
  font-size: 26rpx;
}

.calendar-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-top: 36rpx;
  padding: 32rpx 40rpx;
}

.history-status {
  margin-top: 24rpx;
  color: #71877b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.entry-title {
  color: #2d2926;
  font-size: 30rpx;
  font-weight: 700;
}

.entry-copy {
  flex: 1;
  min-width: 0;
  color: #71877b;
  font-size: 24rpx;
}

.entry-arrow {
  flex-shrink: 0;
  color: #71877b;
  font-size: 40rpx;
}

.note-item {
  padding: 42rpx 0;
  border-bottom: 1rpx solid #e8ded4;
}

.note-date {
  color: #a49a91;
  font-size: 24rpx;
}

.note-title {
  margin-top: 18rpx;
  color: #2d2926;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.note-body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-top: 20rpx;
  color: #6d665f;
  font-size: 26rpx;
  line-height: 42rpx;
}

.note-mood {
  margin-top: 20rpx;
  color: #71877b;
  font-size: 24rpx;
}

.empty {
  margin-top: 80rpx;
  text-align: center;
}

.note-title,
.note-body,
.note-mood,
.entry-copy {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.date-filter, .note-link { display: flex; align-items: center; gap: 24rpx; }
.date-filter { justify-content: space-between; margin-top: 24rpx; color: #71877b; font-size: 24rpx; }
.note-main { flex: 1; min-width: 0; }
.note-thumb-wrap { position: relative; flex-shrink: 0; }
.note-thumb { width: 128rpx; height: 128rpx; border-radius: 20rpx; }
.note-thumb-fallback { display: flex; align-items: center; justify-content: center; background: #edece5; color: #71877b; }
.note-thumb-count { position: absolute; bottom: 8rpx; right: 8rpx; padding: 2rpx 10rpx; border-radius: 12rpx; background: #6d665f; color: white; font-size: 20rpx; }
