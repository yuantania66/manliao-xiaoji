.auth-label {
  margin-top: 72rpx;
}

.auth-copy {
  margin-top: 36rpx;
}

.auth-card {
  margin-top: 56rpx;
  padding: 44rpx;
}

.auth-title {
  margin-bottom: 24rpx;
  color: #71877b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.auth-button {
  margin-top: 56rpx;
}

.auth-secondary {
  display: block;
  margin-top: 26rpx;
}

.intro {
  margin-top: 28rpx;
}

.tone-help {
  margin-top: 20rpx;
  font-size: 22rpx;
}

.range-title {
  margin-top: 48rpx;
}

.range-row {
  display: flex;
  gap: 24rpx;
  margin-top: 26rpx;
}

.range-row button {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  border-radius: 34rpx;
  background: #fffdf9;
  padding: 0 12rpx;
  color: #71877b;
  font-size: 24rpx;
  font-weight: 700;
}

.range-row .active {
  background: #71877b;
  color: #fffdf9;
}

.word-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  margin-top: 40rpx;
}

.word {
  display: flex;
  justify-content: space-between;
  height: 96rpx;
  border-radius: 30rpx;
  padding: 0 32rpx;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  background: #f8ecc8;
  color: #9b8349;
}

.observation-state {
  box-sizing: border-box;
  margin-top: 44rpx;
  padding: 36rpx;
  color: #6d665f;
  font-size: 25rpx;
  line-height: 42rpx;
}

.observation-state button {
  width: auto;
  margin: 18rpx 0 0;
  padding: 0;
  background: transparent;
  color: #71877b;
  font-size: 24rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #2d2926;
  font-size: 28rpx;
  font-weight: 700;
}

.error-card {
  margin-top: 28rpx;
  color: #9f6b61;
}

.quote-card {
  margin-top: 90rpx;
  padding: 42rpx 44rpx;
  color: #71877b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.quote-card text {
  display: block;
  margin-top: 28rpx;
  color: #6d665f;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}
