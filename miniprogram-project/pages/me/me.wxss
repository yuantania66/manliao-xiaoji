.me-page {
  padding-bottom: 180rpx;
  overflow: hidden;
}

.profile-card {
  position: relative;
  min-height: 220rpx;
  margin-top: 58rpx;
  padding: 40rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fffdf9;
  color: #71877b;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.avatar-image { display: block; }
.profile-editor { margin-top: 24rpx; padding: 32rpx; }
.profile-editor input { margin: 20rpx 0; padding: 20rpx; background: #fff; border-radius: 12rpx; }

.profile-title {
  position: absolute;
  left: 168rpx;
  top: 42rpx;
  color: #2d2926;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-card .body {
  position: absolute;
  left: 168rpx;
  top: 96rpx;
}

.connection-status {
  position: absolute;
  left: 168rpx;
  top: 142rpx;
  color: #8f8881;
  font-size: 21rpx;
  line-height: 32rpx;
}

.connection-status.connected {
  color: #5f7c6d;
}

.settings-link {
  position: absolute;
  right: 40rpx;
  top: 42rpx;
  color: #71877b;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-edit-link {
  position: absolute;
  right: 40rpx;
  top: 88rpx;
  width: auto;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #71877b;
  font-size: 22rpx;
  line-height: 34rpx;
}

.login-button {
  margin-top: 34rpx;
}

.login-panel {
  margin-top: 34rpx;
}

.login-panel .login-button {
  margin-top: 20rpx;
}

.login-error {
  margin-bottom: 20rpx;
  color: #9f6b61;
  font-size: 24rpx;
  line-height: 36rpx;
}

.privacy-confirm {
  display: flex;
  align-items: center;
  color: #6d665f;
  font-size: 24rpx;
  line-height: 40rpx;
}

.privacy-link {
  margin-left: 6rpx;
  color: #71877b;
  text-decoration: underline;
}

.wechat-privacy-link {
  width: auto;
  margin: 10rpx 0 0;
  padding: 0;
  background: transparent;
  color: #71877b;
  text-align: left;
  font-size: 22rpx;
  line-height: 34rpx;
  text-decoration: underline;
}

.phone-confirm-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
}

.phone-confirm-mask {
  position: absolute;
  inset: 0;
  background: rgba(91, 83, 77, 0.28);
}

.phone-confirm-sheet {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  padding: 42rpx;
  border-radius: 40rpx;
  background: #fffdf9;
}

.phone-confirm-sheet .login-error {
  margin: 24rpx 0 0;
}

.phone-cancel-button {
  margin-top: 20rpx;
}

.insight-entry {
  position: relative;
  height: 128rpx;
  margin-top: 34rpx;
  padding: 32rpx 40rpx;
}

.entry-title {
  color: #2d2926;
  font-size: 30rpx;
  font-weight: 700;
}

.entry-copy {
  margin-top: 10rpx;
  color: #6d665f;
  font-size: 24rpx;
}

.entry-arrow {
  position: absolute;
  right: 36rpx;
  top: 40rpx;
  color: #71877b;
  font-size: 40rpx;
}

.version {
  margin-top: 58rpx;
  color: #a49a91;
  text-align: center;
  font-size: 24rpx;
  line-height: 42rpx;
}
