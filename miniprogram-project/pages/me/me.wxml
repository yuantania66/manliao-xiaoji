<view class="page me-page" style="padding-top: {{pageTop}}px;">
  <view class="eyebrow">慢聊小记</view>
  <view class="title">{{isLoggedIn ? "我的慢聊小记" : "欢迎来到慢聊小记"}}</view>
  <view class="profile-card card-sage">
    <image wx:if="{{avatarPreview}}" class="avatar avatar-image" src="{{avatarPreview}}" mode="aspectFill" />
    <view wx:else class="avatar">晴</view>
    <view class="profile-title">{{isLoggedIn ? (profileNickname || "我的慢聊小记") : "游客模式"}}</view>
    <view class="body">{{membershipText}}</view>
    <view class="connection-status {{isLoggedIn ? 'connected' : ''}}">{{connectionText}}</view>
    <navigator url="/pages/settings/settings" class="settings-link" hover-class="none">设置</navigator>
    <button wx:if="{{isLoggedIn && !profileEditing}}" class="profile-edit-link" bindtap="editProfile">编辑资料</button>
  </view>
  <view wx:if="{{isLoggedIn && profileEditing}}" class="profile-editor card">
    <view class="entry-title">完善个人资料（可跳过）</view>
    <button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" loading="{{isSavingProfile}}">选择头像</button>
    <input type="nickname" maxlength="30" value="{{profileNickname}}" bindinput="inputNickname" placeholder="输入昵称" />
    <button class="primary-button" bindtap="saveProfile" disabled="{{isSavingProfile || !profileNickname || (!avatarLocalPath && profileNickname === originalProfileNickname)}}">保存</button>
    <button bindtap="skipProfile" disabled="{{isSavingProfile}}">暂时跳过</button>
  </view>
  <view wx:if="{{loginError}}" class="login-error" aria-live="assertive">{{loginError}}</view>
  <view wx:if="{{!isLoggedIn}}" class="login-panel" role="group" aria-label="登录">
    <view class="entry-title">登录慢聊小记</view>
    <view class="entry-copy">可以直接使用微信登录，也可以使用微信绑定手机号登录。</view>
    <checkbox-group class="privacy-confirm" bindchange="togglePrivacy">
      <label><checkbox value="confirmed" checked="{{privacyConfirmed}}" color="#71877b" />我已阅读并同意</label>
      <navigator url="/pages/privacy/privacy" class="privacy-link" hover-class="none">《隐私政策》</navigator>
    </checkbox-group>
    <button class="wechat-privacy-link" bindtap="openWechatPrivacy">查看微信隐私保护指引</button>
    <button class="primary-button login-button" loading="{{isLoggingIn}}" disabled="{{isLoggingIn || isCheckingAuth}}" bindtap="loginWithWechatAccount">微信登录</button>
    <button wx:if="{{phoneLoginReady}}" class="primary-button login-button" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneNumber" loading="{{isLoggingIn}}" disabled="{{isLoggingIn}}">{{isLoggingIn ? "登录中..." : "使用微信手机号继续"}}</button>
    <button wx:else class="primary-button login-button" loading="{{isLoggingIn || isCheckingAuth}}" disabled="{{isLoggingIn || isCheckingAuth}}" bindtap="preparePhoneLogin">{{isCheckingAuth ? "正在验证..." : (isLoggingIn ? "准备中..." : "手机号登录")}}</button>
  </view>
  <navigator url="/pages/insights/insights" class="insight-entry card" hover-class="none">
    <view class="entry-title">慢聊小记观察</view>
    <view class="entry-copy">从聊天和小记里整理出的主题</view>
    <view class="entry-arrow">›</view>
  </navigator>
  <view class="version">慢聊小记 v2.0.0<br />慢慢聊，轻轻记。</view>
  <view class="bottom-bar {{activeTab === 'me' ? 'is-me' : 'is-home'}} {{switchingTab ? 'is-switching' : ''}}">
    <view class="bottom-indicator"></view>
    <button class="bottom-item {{activeTab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="switchTab">此刻</button>
    <button class="bottom-item {{activeTab === 'me' ? 'active' : ''}}" data-tab="me" bindtap="switchTab">我的</button>
  </view>
</view>
