page { overflow: hidden; }
view,image,button,input,navigator,text,label,checkbox { box-sizing: border-box; }
.auth-screen { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #eee6d7; color: #2d2926; font-family: "Noto Sans SC","PingFang SC",sans-serif; }
.auth-background { position:absolute;left:0;width:100%;height:auto; }
.auth-background-blend { position:absolute;left:0;right:0;z-index:1;height:28px;pointer-events:none; }
.auth-mask { position: absolute; inset: 0; width: 100%; height: 100%; }
.auth-mask { background: transparent; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 28px 24px 24px; padding-bottom:max(24px, env(safe-area-inset-bottom)); border-radius: 28px 28px 0 0; background: #fffdf9; }
.choice-sheet { display:flex;flex-direction:column;gap:12px;height:313px;padding-top:22px;border-radius:26px 26px 0 0;box-shadow:0 8px 24px rgba(45,41,38,.09); }
.choice-sheet .sheet-title,.choice-sheet .consent,.choice-sheet .action,.choice-sheet .text-action{margin:0}.choice-sheet .action{align-self:stretch;width:auto;flex:none}.phone-method-sheet{height:272px}.wechat-phone-sheet{height:296px}.sms-sheet{height:405px}.profile-sheet{display:flex;flex-direction:column;height:429px;padding:22px 20px 12px;padding-bottom:max(12px, env(safe-area-inset-bottom))}.avatar-source-sheet{height:382px;padding:22px 18px 24px;padding-bottom:max(24px, env(safe-area-inset-bottom))}.guest-warn-sheet{height:292px}.guest-identity-sheet{display:flex;flex-direction:column;height:454px;padding-top:22px}
.wechat-phone-sheet>.bound-phone,.guest-warn-sheet>.action,.guest-identity-sheet>.action{width:auto;margin-left:0;margin-right:0}
.handle { width:46px;height:5px;margin:0 0 14px;border-radius:3px;background:#ded8d1; }
.sheet-title { margin-bottom:14px;font-size:24px;font-weight:700;line-height:1.2; }.sheet-title.compact{font-size:21px}.center{text-align:center}
.sheet-copy { margin:-4px 0 14px;color:#6d665f;font-size:13px;line-height:1.45; }
.eyebrow { margin-bottom:8px;color:#71877b;font-size:12px;font-weight:500; }
.consent { display:flex;align-items:center;height:42px;margin-bottom:10px;color:#6d665f;font-size:12px; }.consent label{display:flex;align-items:center}.consent checkbox{transform:scale(.78)}.consent navigator{margin-left:3px}.consent-invalid,.consent-invalid label,.consent-invalid navigator{color:#a95f55}.consent-invalid checkbox .wx-checkbox-input{border-color:#a95f55!important}.consent-shake{animation:consent-shake .32s ease-in-out}@keyframes consent-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-3px)}50%{transform:translateX(3px)}75%{transform:translateX(-2px)}}
.action,.bound-phone,.profile-submit,.source { display:flex;align-items:center;justify-content:center;width:100%;height:56px;margin:0 0 14px;border-radius:18px;font-size:17px;font-weight:500;line-height:1; }
.primary{background:#71877b;color:#fff}.soft{background:#e8f0ea}.neutral{background:#f3f0ea}.text-action{display:flex;align-items:center;justify-content:center;width:100%;height:18px;padding:0;margin-left:0;margin-right:0;border-radius:0;background:transparent;color:#52695e;text-align:center;font-size:13px;font-weight:500;line-height:18px}.text-action::after{border:0}.guest{align-self:stretch;width:auto;height:44px;margin:-2px 0 0;text-align:center;opacity:.58}.back{margin-top:0}
.error { margin:-5px 0 10px;color:#9f6b61;text-align:center;font-size:13px;line-height:18px; }
.bound-phone { height:80px;flex-direction:column;background:#52695e;color:#fff;font-size:21px;line-height:28px }.bound-phone text{margin-top:1px;color:#fff;font-size:12px;opacity:.72}
.input-row { display:flex;align-items:center;height:58px;margin-bottom:14px;padding:0 14px;border-radius:16px;background:#f3f0ea }.input-row>text{width:64px;color:#71877b;text-align:right;font-size:14px;font-weight:700;line-height:20px}.input-row input{flex:1;height:20px;margin-left:10px;color:#5c7065;font-size:14px;font-weight:500;line-height:20px}.code-row button{width:76px;color:#5c7065;text-align:right;font-size:13px;line-height:20px}.sms-sheet .action{margin-top:2px}
.app-line{display:flex;align-items:center;height:38px;margin-bottom:10px;gap:10px;font-size:17px;font-weight:700}.app-mark{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:#71877b;color:#fff;font-size:13px}
.profile-row{display:flex;align-items:center;justify-content:space-between;width:100%;height:66px;padding:0 2px;font-size:17px;font-weight:700;flex:none}.profile-avatar-choice{display:flex;align-items:center;justify-content:center;width:54px;height:54px;margin:0;padding:0;border-radius:12px;background:#e8f0ea}.profile-avatar-choice image,.profile-avatar-choice>view{display:flex;align-items:center;justify-content:center;width:54px;height:54px;border:1px solid #cad6cd;border-radius:12px;background:#e8f0ea;color:#71877b;font-size:12px}.profile-avatar-choice .generated-avatar{border:0;border-radius:50%;color:#fff;font-size:18px}.divider{height:1px;background:#e8e1d9;flex:none}.nickname-row input{width:190px;height:66px;text-align:right;font-size:16px;font-weight:400}.profile-submit{height:56px;margin:auto 0 8px;border-radius:16px;background:#71877b;color:#fff;font-size:17px;font-weight:700;flex:none}.profile-submit[disabled]{opacity:.38}.abandon{color:#9f6b61;flex:none}
.source{height:58px;margin-bottom:10px;border-radius:16px;background:#fbf7f0}.source.wechat{background:#e8f0ea}.source-divider{height:7px;margin-bottom:10px;background:#f3f0ea}.source.cancel{height:56px;margin:0;background:#fffdf9;color:#9f6b61}
.guest-warn-sheet .sheet-copy{margin-bottom:26px}.guest-helper{display:flex;align-items:center;min-height:34px;margin:-4px 0 4px;color:#6d665f;font-size:13px;line-height:20px}.guest-helper button{display:inline-flex;align-items:center;margin:0 0 0 3px;padding:0;border-radius:0;background:transparent;color:#52695e;font-size:13px;font-weight:600;line-height:20px}.guest-helper button::after{border:0}.guest-profile-row{display:flex;align-items:center;justify-content:space-between;width:100%;height:76px;padding:0 2px;font-size:17px;font-weight:700}.guest-avatar-choice{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:0;padding:0;background:transparent;color:#6d665f;font-size:12px}.guest-avatar-choice::after{border:0}.guest-avatar{display:flex;align-items:center;justify-content:center;width:58px;height:58px;border-radius:50%;color:#fff;font-size:20px;font-weight:700}.guest-nickname-row input{width:190px;height:66px;text-align:right;font-size:16px;font-weight:400}.guest-identity-sheet>.action{margin:auto 0 10px}.guest-identity-sheet>.text-action{margin:0;color:#2d2926;opacity:.64}
button[disabled]{opacity:.5}
