@import "../../styles/note-card.wxss";
.note-page {
  padding-bottom: 120rpx;
}

.date {
  margin-top: 86rpx;
  color: #71877b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.note-back {
  position: fixed;
  left: 42rpx;
  top: 96rpx;
  z-index: 25;
}

.note-menu-button {
  position: fixed;
  top: 188rpx;
  right: 42rpx;
  z-index: 20;
  width: 77rpx;
  height: 42rpx;
  color: #71877b;
  text-align: center;
  font-size: 35rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.menu-layer {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(251, 247, 240, 0.52);
}

.note-menu {
  position: fixed;
  top: 250rpx;
  right: 42rpx;
  z-index: 40;
  width: auto;
  max-width: calc(100vw - 84rpx);
  display: inline-flex;
  flex-direction: column;
  height: auto;
  border-radius: 31rpx;
  background: #fffdf9;
  padding: 22rpx 28rpx;
  color: #2d2926;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 44rpx;
  box-sizing: border-box;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 50rpx;
  color: #2d2926;
}

.menu-item text {
  display: block;
  white-space: nowrap;
  margin-left: 22rpx;
}

.menu-icon {
  position: relative;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
}

.menu-icon-image {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

.menu-line {
  height: 1rpx;
  margin: 12rpx 0;
  background: #e8ded4;
}

.note-title {
  position: fixed;
  left: 42rpx;
  top: 174rpx;
  z-index: 15;
  width: 520rpx;
  margin-top: 0;
  color: #2d2926;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.note-lead {
  margin-top: 24rpx;
  white-space: pre-line;
  color: #6d665f;
  font-size: 28rpx;
  line-height: 50rpx;
}

.mode-notice {
  box-sizing: border-box;
  width: 100%;
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.78);
  color: #71877b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.note-card {
  position: relative;
  width: 100%;
  height: 564rpx;
  margin-top: 54rpx;
  border-radius: 40rpx;
  background: #fffdf9;
}

.note-textarea {
  width: 100%;
  height: 452rpx;
  padding: 44rpx 40rpx 24rpx;
  color: #2d2926;
  font-size: 28rpx;
  line-height: 48rpx;
}

.note-textarea-placeholder {
  color: #8f8881;
  line-height: 48rpx;
}

.note-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: #fffdf9;
}

.counter {
  position: absolute;
  left: 40rpx;
  bottom: 36rpx;
  color: #a49a91;
  font-size: 24rpx;
  line-height: 36rpx;
}

.mood-button {
  position: absolute;
  right: 40rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  min-width: 190rpx;
  height: 50rpx;
  color: #71877b;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.selected-mood-placeholder {
  color: #71877b;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.mood-clear {
  color: #a49a91;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.note-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
}

.media-preview-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  margin-right: -16rpx;
  padding-bottom: 8rpx;
}

.media-preview-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #e8f0ea;
}

.media-preview-image {
  width: 100%;
  height: 100%;
}

.media-remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(45, 41, 38, 0.34);
  color: #fffdf9;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.media-button {
  position: relative;
  width: 332rpx;
  height: 116rpx;
  border-radius: 32rpx;
  background: #fffdf9;
  color: #71877b;
  text-align: left;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 116rpx;
  padding-left: 40rpx;
}

.media-title {
  position: absolute;
  left: 88rpx;
  top: 28rpx;
  color: #71877b;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.media-sub {
  position: absolute;
  left: 88rpx;
  top: 66rpx;
  color: #a49a91;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.save-note {
  width: 164rpx;
  height: 116rpx;
  border-radius: 32rpx;
  background: #71877b;
  color: #fffdf9;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 116rpx;
}

.save-note[disabled] {
  background: #d8d1c9;
}

.note-leaf {
  position: absolute;
  right: 8rpx;
  top: 660rpx;
  width: 250rpx;
  height: 230rpx;
}

.leaf-circle {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #f4e4d3;
}

.leaf-stem {
  position: absolute;
  left: 112rpx;
  top: 40rpx;
  width: 7rpx;
  height: 150rpx;
  border-radius: 999rpx;
  background: #71877b;
  transform: rotate(28deg);
}

.leaf-one,
.leaf-two {
  position: absolute;
  border-radius: 999rpx;
  background: #d7e6dd;
}

.leaf-one {
  left: 54rpx;
  top: 18rpx;
  width: 54rpx;
  height: 120rpx;
  transform: rotate(-28deg);
}

.leaf-two {
  left: 150rpx;
  top: 14rpx;
  width: 48rpx;
  height: 104rpx;
  transform: rotate(30deg);
}

.history-link {
  display: block;
  width: 100%;
  margin: 96rpx auto 0;
  padding-bottom: 24rpx;
  color: #71877b;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.mood-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: #fbf7f0;
}

.mood-layer {
  padding: 0;
}

.mood-eyebrow {
  position: absolute;
  left: 42rpx;
  top: 112rpx;
  width: 577rpx;
  height: 35rpx;
  color: #71877b;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 35rpx;
}

.mood-close {
  position: absolute;
  right: 72rpx;
  top: 166rpx;
  width: 64rpx;
  height: 64rpx;
  z-index: 5;
  color: #71877b;
  text-align: center;
  font-size: 42rpx;
  line-height: 64rpx;
}

.mood-title {
  position: absolute;
  left: 42rpx;
  top: 169rpx;
  width: 654rpx;
  height: 73rpx;
  color: #2d2926;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 73rpx;
}

.mood-copy {
  position: absolute;
  left: 42rpx;
  top: 277rpx;
  width: 662rpx;
  height: 42rpx;
  color: #6d665f;
  font-size: 25rpx;
  line-height: 42rpx;
}

.mood-grid {
  position: absolute;
  left: 42rpx;
  top: 458rpx;
  width: 627rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 35rpx;
  row-gap: 38rpx;
}

.mood-card {
  position: relative;
  height: 150rpx;
  border-radius: 35rpx;
  background: #fffdf9;
}

.mood-hit {
  position: absolute;
  inset: 0;
  z-index: 4;
  border-radius: 35rpx;
}

.mood-card-0 {
  background: #f4e4d3;
}

.mood-card-1,
.mood-card-2,
.mood-card-7 {
  background: #e8f0ea;
}

.mood-card-3 {
  background: #eef0ee;
}

.mood-card-4 {
  background: #e4ecf0;
}

.mood-card-5 {
  background: #e8e5e1;
}

.mood-card-6 {
  background: #eae6de;
}

.mood-card-8 {
  background: #f1e9e2;
}

.mood-card-wide {
  position: absolute;
  left: 42rpx;
  top: 1212rpx;
  width: 627rpx;
}

.mood-icon {
  position: absolute;
  left: 38rpx;
  top: 42rpx;
  width: 62rpx;
  height: 62rpx;
}

.icon-part {
  position: absolute;
  display: none;
}

.sun-core {
  left: 21rpx;
  top: 21rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d6b47b;
}

.sun-rays {
  left: 28rpx;
  top: 4rpx;
  width: 6rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #d6b47b;
  box-shadow:
    0 40rpx 0 #d6b47b,
    20rpx 20rpx 0 #d6b47b,
    -20rpx 20rpx 0 #d6b47b;
}

.sun-rays::before,
.sun-rays::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #d6b47b;
  transform-origin: 3rpx 27rpx;
}

.sun-rays::before {
  transform: rotate(45deg);
  box-shadow: 0 40rpx 0 #d6b47b;
}

.sun-rays::after {
  transform: rotate(-45deg);
  box-shadow: 0 40rpx 0 #d6b47b;
}

.cloud-sun {
  left: 10rpx;
  top: 11rpx;
  width: 19rpx;
  height: 19rpx;
  border-radius: 50%;
  background: #d6b47b;
}

.cloud-body {
  left: 15rpx;
  top: 29rpx;
  width: 43rpx;
  height: 19rpx;
  border-radius: 999rpx;
  background: #b9c8c6;
}

.cloud-body::before,
.cloud-body::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: inherit;
}

.cloud-body::before {
  left: 16rpx;
  top: -14rpx;
  width: 27rpx;
  height: 27rpx;
}

.cloud-body::after {
  left: 0;
  top: -5rpx;
  width: 20rpx;
  height: 20rpx;
}

.rain {
  top: 48rpx;
  width: 5rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: #71877b;
  transform: rotate(45deg);
}

.rain-one {
  left: 19rpx;
}

.rain-two {
  left: 32rpx;
}

.rain-three {
  left: 45rpx;
}

.fog {
  left: 10rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #8d9a95;
}

.fog-one {
  top: 20rpx;
  width: 42rpx;
}

.fog-two {
  top: 31rpx;
  left: 6rpx;
  width: 50rpx;
}

.fog-three {
  top: 43rpx;
  left: 17rpx;
  width: 33rpx;
}

.rainbow-one,
.rainbow-two,
.rainbow-three {
  border-style: solid;
  border-bottom: 0;
  background: transparent;
}

.rainbow-one {
  left: 9rpx;
  top: 23rpx;
  width: 44rpx;
  height: 25rpx;
  border-width: 5rpx;
  border-color: #d77b70;
  border-radius: 44rpx 44rpx 0 0;
}

.rainbow-two {
  left: 17rpx;
  top: 31rpx;
  width: 28rpx;
  height: 16rpx;
  border-width: 5rpx;
  border-color: #d6b47b;
  border-radius: 28rpx 28rpx 0 0;
}

.rainbow-three {
  left: 25rpx;
  top: 39rpx;
  width: 12rpx;
  height: 8rpx;
  border-width: 5rpx;
  border-color: #71877b;
  border-radius: 12rpx 12rpx 0 0;
}

.moon-base,
.moon-cut {
  border-radius: 50%;
}

.moon-base {
  left: 12rpx;
  top: 13rpx;
  width: 38rpx;
  height: 38rpx;
  background: #c89c86;
}

.moon-cut {
  left: 24rpx;
  top: 7rpx;
  width: 38rpx;
  height: 38rpx;
  background: #fffdf9;
}

.mood-icon-0 .sun-core,
.mood-icon-0 .sun-rays,
.mood-icon-1 .cloud-sun,
.mood-icon-1 .cloud-body,
.mood-icon-2 .cloud-sun,
.mood-icon-2 .cloud-body,
.mood-icon-3 .cloud-body,
.mood-icon-4 .cloud-body,
.mood-icon-4 .rain,
.mood-icon-5 .cloud-body,
.mood-icon-5 .rain,
.mood-icon-6 .fog,
.mood-icon-7 .rainbow-one,
.mood-icon-7 .rainbow-two,
.mood-icon-7 .rainbow-three,
.mood-icon-8 .moon-base,
.mood-icon-8 .moon-cut {
  display: block;
}

.mood-icon-2 .cloud-sun {
  background: #d6b47b;
}

.mood-icon-2 .cloud-body {
  background: #71877b;
}

.mood-icon-5 .cloud-body {
  background: #6e7780;
}

.mood-icon-5 .rain {
  background: #6e7780;
}

.mood-button .selected-mood-icon {
  position: relative;
  left: auto;
  top: auto;
  flex: 0 0 44rpx;
  width: 62rpx;
  height: 62rpx;
  margin-right: -12rpx;
  transform: scale(0.62);
  transform-origin: left center;
}

.mood-name {
  position: absolute;
  left: 127rpx;
  top: 29rpx;
  color: #2d2926;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.mood-desc {
  position: absolute;
  left: 127rpx;
  top: 85rpx;
  color: #6d665f;
  font-size: 23rpx;
  line-height: 31rpx;
}

.skip-mood {
  position: absolute;
  left: 42rpx;
  top: 1400rpx;
  width: 627rpx;
  height: 85rpx;
  border-radius: 35rpx;
  background: #fffdf9;
  color: #71877b;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 85rpx;
}

.mood-note {
  position: absolute;
  left: 42rpx;
  top: 1523rpx;
  width: 627rpx;
  color: #a49a91;
  text-align: center;
  font-size: 21rpx;
  line-height: 33rpx;
}
